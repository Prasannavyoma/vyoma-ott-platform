# ==============================================================================
# Vyoma OTT Platform - Environment Variables Template
# Copy this file to .env and provide your deployment-specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / AWS RDS)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/vyoma_ott?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret for signing HMAC-SHA256 session cookies (32+ chars recommended)
AUTH_SECRET="your_production_hmac_secret_key_minimum_32_chars"

# Master administrative key for emergency provisioning and super-admin access
ADMIN_MASTER_KEY="your_secure_admin_master_passphrase"

# Optional: set to 'true' to force secure cookies over HTTPS, or 'false' for plain HTTP dev
# COOKIE_SECURE="true"

# ------------------------------------------------------------------------------
# 3. AI & CHATBOT ENGINE (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_or_live_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 5. PLATFORM METADATA & URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@vyomalabs.in"
SMTP_PASS="your_smtp_app_password"

# ------------------------------------------------------------------------------
# 7. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:admin@vyomalabs.in"

# ------------------------------------------------------------------------------
# 8. BACKGROUND CRON & SCHEDULER
# ------------------------------------------------------------------------------
# Bearer token for triggering /api/cron/lifecycle-emails and /api/cron/whatsapp-reminders
CRON_SECRET="your_secure_cron_trigger_token"

# ------------------------------------------------------------------------------
# 9. SEARCH ENGINE (Meilisearch - Optional)
# ------------------------------------------------------------------------------
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY="your_meilisearch_master_key"

# ------------------------------------------------------------------------------
# 10. CMS DATA MIGRATION (Optional / Legacy Sync)
# ------------------------------------------------------------------------------
# WP_URL="https://your-wordpress-site.com"
# WP_USER="api_user"
# WP_APP_PASSWORD="application_password"
