        			<script>
				const lazyloadRunObserver = () => {
					const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
					const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
						entries.forEach( ( entry ) => {
							if ( entry.isIntersecting ) {
								let lazyloadBackground = entry.target;
								if( lazyloadBackground ) {
									lazyloadBackground.classList.add( 'e-lazyloaded' );
								}
								lazyloadBackgroundObserver.unobserve( entry.target );
							}
						});
					}, { rootMargin: '200px 0px 200px 0px' } );
					lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
						lazyloadBackgroundObserver.observe( lazyloadBackground );
					} );
				};
				const events = [
					'DOMContentLoaded',
					'elementor/lazyload/observe',
				];
				events.forEach( ( event ) => {
					document.addEventListener( event, lazyloadRunObserver );
				} );
			</script>
			<script>document.addEventListener("DOMContentLoaded", function () {

  /* ============ MEILI (PRODUCTION) ============ */
  var client = new MeiliSearch({
    host: "https://search.floralwhite-marten-419677.hostingersite.com",
    apiKey: "8600b7a424d3b9d362829f7b8d7d40bc9dc834ee6c2241d745677eeca2a9e1fe"
  });

  var INDEX = "BooksPanel";
  var searchInput = document.querySelector(".s");
  var formWrapper = document.querySelector(".jws-search-form");
  if (!searchInput || !formWrapper) return;

  /* ============ TOGGLE UI ============ */
  if (!document.getElementById("contentToggle")) {
    var holder = document.createElement("div");
    holder.style.display = "flex";
    holder.style.justifyContent = "flex-end";
    holder.style.marginTop = "6px";
    holder.innerHTML =
      '<label style="display:flex;align-items:center;gap:8px;color:#fff;font-size:13px;cursor:pointer;">' +
      '<span style="opacity:.8;">To search inside book →</span>' +
      '<input type="checkbox" id="contentToggle">' +
      '<span>Content Search</span>' +
      '</label>';
    formWrapper.appendChild(holder);
  }

  var toggle = document.getElementById("contentToggle");

  /* ============ DOM ============ */
  function ensureDOM() {
    var wrap = document.getElementById("meili-live-wrapper");
    if (!wrap) {
      wrap = document.createElement("div");
      wrap.id = "meili-live-wrapper";
      wrap.style.maxWidth = "1140px";
      wrap.style.margin = "0 auto";
      wrap.style.padding = "1rem";
      formWrapper.insertAdjacentElement("afterend", wrap);
    }

    var info = document.getElementById("meili-result-info");
    if (!info) {
      info = document.createElement("div");
      info.id = "meili-result-info";
      info.style.display = "none";
      wrap.appendChild(info);
    }

    var res = document.getElementById("meili-results");
    if (!res) {
      res = document.createElement("div");
      res.id = "meili-results";
      res.style.display = "grid";
      res.style.gridTemplateColumns = "repeat(auto-fit, minmax(200px,1fr))";
      res.style.gap = "0.8rem";
      wrap.appendChild(res);
    }

    return { results: res, info: info };
  }

  /* ============ OVERLAY ============ */
  if (!document.getElementById("meili-overlay")) {
    var ov = document.createElement("div");
    ov.id = "meili-overlay";
    ov.style.cssText =
      "display:none;position:fixed;inset:0;z-index:99999;" +
      "background:rgba(0,0,0,.25);backdrop-filter:blur(6px);" +
      "justify-content:center;align-items:center";

    ov.innerHTML =
      '<div id="meili-overlay-inner" style="background:#0b1f3a;padding:20px;' +
      'max-height:80vh;overflow-y:auto;width:60%;border-radius:12px"></div>';

    document.body.appendChild(ov);
    ov.addEventListener("click", e => {
      if (e.target === ov) ov.style.display = "none";
    });
  }

  var overlay = document.getElementById("meili-overlay");
  var overlayInner = document.getElementById("meili-overlay-inner");

  /* ============ ENGLISH STOP WORDS ============ */

  var STOP_WORDS = [
    "the","a","an","and","of","in","on","at","to","for",
    "is","are","was","were","be","been","being","by",
    "with","as","from","that","this","it","or"
  ];

  function cleanQueryForSearch(q) {
    var words = q.trim().split(/\s+/);

    var cleaned = words.filter(function(word) {

      if (/^[A-Za-z]+$/.test(word)) {
        return !STOP_WORDS.includes(word.toLowerCase());
      }

      // Non-English → require minimum 2 characters
      return word.length >= 2;

    });

    return cleaned.join(" ");
  }

  function showMinimumMessage() {
    var dom = ensureDOM();
    dom.results.innerHTML = "";
    dom.info.style.display = "block";
    dom.info.innerHTML =
      "<span style='opacity:.8;'>Please enter a more specific term to search inside book content.</span>";
  }

  /* ============ HELPERS (UNCHANGED) ============ */

  function splitIntoPages(text) {
    var re = /Page\s*\d+\b/gi, m, marks = [];
    while ((m = re.exec(text)) !== null) marks.push({ i: m.index, l: m[0] });
    if (!marks.length) return [];

    var pages = [];
    for (var i = 0; i < marks.length; i++) {
      var s = marks[i].i;
      var e = marks[i + 1] ? marks[i + 1].i : text.length;
      pages.push({ label: marks[i].l, text: text.slice(s, e) });
    }
    return pages;
  }

  function previewSnippet(pageText) {
    var snippets = [];
    var words = pageText.match(/<mark>.*?<\/mark>|\S+/g) || [];
    for (var i = 0; i < words.length; i++) {
      if (!words[i].includes("<mark>")) continue;
      snippets.push(words.slice(Math.max(0, i - 3), i + 4).join(" "));
    }
    return snippets;
  }

  function expandedSnippet(text) {
    var sentences = text.split(/(?<=[.।!?])\s+/);
    var idx = sentences.findIndex(s => s.includes("<mark>"));
    if (idx === -1) return text;
    return sentences.slice(Math.max(0, idx - 3), idx + 4).join(" ");
  }

  /* ============ ANALYTICS (PRODUCTION) ============ */

  var analyticsTimer = null;
  var lastLoggedQuery = "";
  var lastLoggedCount = null;

  function logContentSearchAnalytics(q, count) {
    if (q === lastLoggedQuery && count === lastLoggedCount) return;

    lastLoggedQuery = q;
    lastLoggedCount = count;

    clearTimeout(analyticsTimer);
    analyticsTimer = setTimeout(function () {
      fetch("https://analytics.floralwhite-marten-419677.hostingersite.com/track-search-prod.php", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-API-KEY": "prod_secret_abc"
        },
        body: JSON.stringify({
          search_term: q,
          results_count: count,
          search_type: "content"
        })
      }).catch(() => {});
    }, 600);
  }

  /* ============ CONTENT SEARCH ============ */

  var token = 0;

  function clearResults() {
    token++;
    var dom = ensureDOM();
    dom.results.innerHTML = "";
    dom.info.style.display = "none";
    overlay.style.display = "none";
  }

  function runContentSearch(q) {
    var dom = ensureDOM();
    var t = ++token;

    client.index(INDEX).search(q, {
      limit: 200,
      attributesToHighlight: ["content"],
      highlightPreTag: "<mark>",
      highlightPostTag: "</mark>"
    }).then(res => {
      if (t !== token) return;

      dom.results.innerHTML = "";
      dom.info.style.display = "block";

      var shown = 0;

      res.hits.forEach(hit => {
        if (!hit.url || !hit._formatted?.content) return;

        var pages = splitIntoPages(hit._formatted.content);
        var previewHTML = "";
        var fullHTML = "";

        pages.forEach(pg => {
          if (!pg.text.includes("<mark>")) return;

          previewHTML += `<div class="page-label">${pg.label}</div>`;
          previewSnippet(pg.text).forEach(p => previewHTML += "• " + p + "<br>");

          fullHTML += `<div class="page-label">${pg.label}</div>`;
          fullHTML += expandedSnippet(pg.text) + "<br><br>";
        });

        if (!previewHTML) return;

        var card = document.createElement("a");
        card.className = "meili-card";
        card.href = hit.url;
        card.target = "_blank";
        card.rel = "noopener noreferrer";

        card.innerHTML =
          '<div class="meili-badge">CONTENT</div>' +
          '<h3>' + (hit.title || "Untitled") + '</h3>' +
          '<div class="meili-divider"></div>';

        var p = document.createElement("p");
        p.innerHTML = previewHTML;
        card.appendChild(p);

        var btn = document.createElement("button");
        btn.className = "view-full-btn";
        btn.innerText = "View Full";
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          overlayInner.innerHTML =
            "<h2>" + (hit.title || "") + "</h2>" + fullHTML;
          overlay.style.display = "flex";
        };

        card.appendChild(btn);
        dom.results.appendChild(card);
        shown++;
      });

      dom.info.innerText = shown + " content result(s)";
      logContentSearchAnalytics(q, shown);
    });
  }

  /* ============ EVENTS ============ */

  searchInput.addEventListener("input", function (e) {

    if (!toggle.checked) return;

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    var q = searchInput.value.trim();
    if (!q) {
      clearResults();
      return;
    }

    var cleaned = cleanQueryForSearch(q);

    if (cleaned.trim().length >= 2) {
      runContentSearch(cleaned);
    } else {
      showMinimumMessage();
    }

  }, true);

  toggle.addEventListener("change", function () {
    var q = searchInput.value.trim();

    if (toggle.checked) {
      var cleaned = cleanQueryForSearch(q);
      if (cleaned.trim().length >= 2) runContentSearch(cleaned);
    } else {
      clearResults();
      searchInput.dispatchEvent(new Event("input", { bubbles: true }));
    }
  });

});
</script><script>document.addEventListener("DOMContentLoaded", function () {

  const client = new MeiliSearch({
    host: "https://search.floralwhite-marten-419677.hostingersite.com",
    apiKey: "8600b7a424d3b9d362829f7b8d7d40bc9dc834ee6c2241d745677eeca2a9e1fe"
  });

  const indexes = [
    "addonsfinal","audiosfinal","ebooksfinal",
    "gamesfinal","multimediafinal","podcastsfinal","videosfinal"
  ];
const searchInput =
  document.querySelector(".s") ||
  document.querySelector('input[name="s"]');

const formWrapper =
  document.querySelector(".jws-search-form") ||
  document.querySelector("form[role='search']");

const searchButton =
  document.querySelector(".searchsubmit") ||
  document.querySelector("button[type='submit']");

const genreDropdown =
  document.querySelector(".choose-post");

if (!searchInput || !formWrapper || !genreDropdown) {
  console.log("Search elements not found in DOM.");
  return;
}


  if (!searchInput || !formWrapper || !searchButton || !genreDropdown) return;

  /* 🔒 Disable browser suggestions */
  searchInput.setAttribute("autocomplete", "off");
  searchInput.setAttribute("autocorrect", "off");
  searchInput.setAttribute("autocapitalize", "off");
  searchInput.setAttribute("spellcheck", "false");

  /* ================= GENRES ================= */
  const genres = [
    "All","World of Chants","Bhakti Bhava Lahari","Language Learning",
    "Grammar Simplified","Stories & Subhashitas","Literature",
    "Evergreen Epics & Puranas","Roots of Dharma","Vedanta",
    "IKS","Games & Activities","Kids","Shaastra Studies","Gita","Devotional"
  ];

  genreDropdown.innerHTML = `
    <option value="">All</option>
    ${genres.filter(g => g !== "All").map(g => `<option value="${g}">${g}</option>`).join("")}
  `;

  /* ================= DOM ================= */
  const wrapper = document.getElementById("meili-live-wrapper") || (() => {
    const w = document.createElement("div");
    w.id = "meili-live-wrapper";
    w.style.maxWidth = "1140px";
    w.style.margin = "0 auto";
    w.style.padding = "1rem";
    formWrapper.insertAdjacentElement("afterend", w);
    return w;
  })();

  const resultInfo = document.getElementById("meili-result-info") || (() => {
    const r = document.createElement("div");
    r.id = "meili-result-info";
    r.style.display = "none";
    wrapper.appendChild(r);
    return r;
  })();

  const resultsContainer = document.getElementById("meili-results") || (() => {
    const d = document.createElement("div");
    d.id = "meili-results";
    d.style.display = "grid";
    d.style.gridTemplateColumns = "repeat(auto-fit, minmax(200px, 1fr))";
    d.style.gap = "0.8rem";
    wrapper.appendChild(d);
    return d;
  })();

  /* ================= ANALYTICS (PRODUCTION) ================= */
  let analyticsTimer = null;
  let lastQuery = "";
  let lastCount = null;

  function logNormalSearchAnalytics(query, count) {
    if (query === lastQuery && count === lastCount) return;

    lastQuery = query;
    lastCount = count;

    clearTimeout(analyticsTimer);
    analyticsTimer = setTimeout(() => {
      fetch("https://analytics.floralwhite-marten-419677.hostingersite.com/track-search-prod.php", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-API-KEY": "prod_secret_abc"
        },
        body: JSON.stringify({
          search_term: query,
          results_count: count,
          search_type: "normal"
        })
      }).catch(() => {});
    }, 600);
  }

  /* ================= RENDER ================= */
  function showResults(results, genreSelected) {
    resultsContainer.innerHTML = "";

    if (!results.length) {
      resultInfo.style.display = "block";
      resultInfo.innerHTML = "No results found.";
      return;
    }

    resultInfo.style.display = "block";
    resultInfo.innerHTML = `${results.length} results found`;
    if (genreSelected) resultInfo.innerHTML += ` <span class="filter-icon">🎯</span>`;

    results.forEach(r => {
      const card = document.createElement("a");
      card.className = "meili-card";
      card.href = r.url || "#";
      card.target = "_blank";

      card.innerHTML = `
        <div class="meili-badge">
          ${(r._formatted?.category || r.category || "Unknown").toUpperCase()}
        </div>
        <h3>${r._formatted?.title || r.title}</h3>
        <div class="meili-divider"></div>
        <p>${r._formatted?.description || r.description || ""}</p>
      `;

      resultsContainer.appendChild(card);
    });
  }

  /* ================= SEARCH ================= */
  let activeToken = 0;

  async function performSearch(query, token) {
    let all = [];

    for (const idx of indexes) {
      try {
        const res = await client.index(idx).search(query, {
          limit: 1000,
          attributesToHighlight: ["title","description","category"],
          highlightPreTag: "<mark>",
          highlightPostTag: "</mark>"
        });
        all.push(...res.hits);
      } catch {}
    }

    if (token !== activeToken) return;

    const seen = new Set();
    const unique = all.filter(x => {
      const k = x.url || x.title;
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });

    const genreVal = genreDropdown.value;
    const genreFiltered = unique.filter(item => {
      if (!genreVal) return true;
      return Object.entries(item).some(([k,v]) =>
        k.toLowerCase().startsWith("genre") &&
        String(v).toLowerCase() === genreVal.toLowerCase()
      );
    });

    const titleMatches = [];
    const descMatches  = [];
    const catMatches   = [];

    genreFiltered.forEach(item => {
      if (item._formatted?.title?.includes("<mark>")) {
        titleMatches.push(item);
      } else if (item._formatted?.description?.includes("<mark>")) {
        descMatches.push(item);
      } else if (item._formatted?.category?.includes("<mark>")) {
        catMatches.push(item);
      }
    });

    const finalResults = [...titleMatches, ...descMatches, ...catMatches];

    showResults(finalResults, !!genreVal);

    // ✅ PRODUCTION ANALYTICS
    logNormalSearchAnalytics(query, finalResults.length);
  }

  searchInput.addEventListener("input", function () {
    const q = this.value.trim();

    if (q.length < 2) {
      activeToken = 0;
      resultsContainer.innerHTML = "";
      resultInfo.style.display = "none";
      return;
    }

    activeToken = Date.now();
    performSearch(q, activeToken);
  });

  genreDropdown.addEventListener("change", function () {
    const q = searchInput.value.trim();
    if (q.length >= 2) {
      activeToken = Date.now();
      performSearch(q, activeToken);
    }
  });

});
