@font-face {
    font-family: 'Futura display';
    src: url('https://floralwhite-marten-419677.hostingersite.com/wp-content/futura-display-cufonfonts/Futura%20Display.ttf') format('truetype');
    font-weight: 300;
    font-style: normal;
}

@font-face {
    font-family: 'Shobhika';
    src: url('https://floralwhite-marten-419677.hostingersite.com/wp-content/futura-display-cufonfonts/SHOBHIKA-REGULAR.OTF') format('truetype');
}

.sss-dia{
	font-family : 'Shobhika' !important ;
}


@font-face {
    font-family: 'Futura light';
    src: url('https://floralwhite-marten-419677.hostingersite.com/wp-content/futura-display-cufonfonts/futura%20light%20bt.ttf') format('truetype');
    font-weight: 300;
    font-style: normal;
}

h1, h2, h3, h4, h5, h6,
p, a, span, li, input, textarea, label, form, .jws-description, .form-label {
    font-family: 'Futura light', sans-serif !important;
    font-weight: 900 !important;
}

/* Fix: Only override TEXT parts to inherit; leave icons alone */
.video-js .vjs-control-text,
.video-js .vjs-menu-item,
.video-js .vjs-playback-rate-value,
.video-js .vjs-duration-display,
.video-js .vjs-current-time-display,
.video-js .vjs-control.vjs-icon-playback-rate{
    font-family: inherit !important;
    font-weight: inherit !important;
}



/* Preserve icons: don't apply Futura to icon placeholders */
.video-js .vjs-icon-placeholder,
.video-js .vjs-control.vjs-icon-fullscreen,
.video-js .vjs-control.vjs-icon-play,
.video-js .vjs-control.vjs-icon-pause,
.video-js .vjs-control.vjs-icon-volume-high,
.video-js .vjs-control.vjs-icon-volume-mute,
.video-js .vjs-control.vjs-icon-settings {
    font-family: 'VideoJS' !important; 
    font-weight: normal !important;
}


.fa, .far, .fal, .fad, .jws-raring-result,
.jws-raring-result::before,
.jws-raring-result i,
.jws-raring-result span {
    font-family: 'Font Awesome 5 Free' !important;
    font-weight: 400 !important;
    font-style: normal !important;
}



.backToTop {
    font-family: 'Font Awesome 5 Free' !important;
    font-weight: 900 !important;
    font-style: normal;
    text-align: center;
    font-size: 16px;
    line-height: 50px;
    color: #333333;
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 50px;
    height: 50px;
    border-radius: 100%;
    background: #ffffff;
    z-index: 99;
    opacity: 0;
    transition: opacity 0.3s ease;
    box-shadow: 0 7px 16px rgba(0, 0, 0, 0.1);
}

.backToTop.totop-show {
    opacity: 1;
}

@media (max-width: 1024px) {
    .backToTop {
        bottom: 65px;
    }
}



.single_add_to_cart_button.button.alt {
    background-color: #0071be !important;
    color: #ffffff !important;
    border: none !important;
    padding: 6px 16px !important;   /* Reduced padding */
    font-size: 18px !important;     /* Smaller text */
    font-weight: 500 !important;
    border-radius: 4px !important;  /* Subtle rounding */
    width: auto !important;         /* Keeps it small instead of full width */
    display: inline-block;
}

.single_add_to_cart_button.button.alt:hover {
    background-color: #005fa3 !important;
    color: #ffffff !important;
}



/* Dark background for submenu */
ul.sub-menu {
    background-color: #111827 !important;
    padding: 10px 0 !important;
    border-radius: 10px !important;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3) !important;
    min-width: 220px !important;
}

/* Style submenu links */
ul.sub-menu li a {
    color: #ffffff !important;
    padding: 10px 20px !important;
    display: block !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    transition: background-color 0.3s ease, color 0.3s ease !important;
}

/* Hover effect for links */
ul.sub-menu li a:hover {
    background-color: #1e293b !important;
    color: #00b4d8 !important;
}
