.profile-header .nav-item.nav-shop {
  display: none !important;
}


/* Specifically style only the 'Your Level' button inside the pricing section */
/* Highlight the full pricing box that contains 'Your Level' button */
.pmpro-level-item .your-level-btn {
    background-color: #f9b233 !important;  /* Highlight button */
    color: #000 !important;
    font-weight: 700;
    border: 2px solid #f39c12;
    box-shadow: 0 0 10px rgba(249, 178, 51, 0.7);
}

/* Highlight the parent box of that button */
.pmpro-level-inner .your-level-btn:only-child {
    border-radius: 8px;
}

.pmpro-level-inner:has(.your-level-btn) {
    border: 3px solid #f9b233 !important;
    box-shadow: 0 0 15px rgba(249, 178, 51, 0.6);
    border-radius: 10px;
}

/* make the column height equal */
/* Container Row */
.row.row-eq-height {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch; /* ensures equal height */
  gap: 30px;
}

/* Each column */
.pmpro-level-item {
  display: flex;
  flex-direction: column;
  height: auto;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  min-width: 300px; /* or whatever minimum you want */
}

/* Inner content */
.pmpro-level-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
}





/* ————————————————————————————————
   1) Force Owl’s stage into one single‐row flex
———————————————————————————————— */
.jws-episodes_advanced-element .owl-stage {
  display: flex !important;
  flex-wrap: nowrap !important;
  gap: 1rem !important;   /* ← adjust this to taste */
}

/* ————————————————————————————————
   2) Neutralize Owl’s inline margins/widths
———————————————————————————————— */
.jws-episodes_advanced-element .owl-item {
  margin: 0 !important;
  width: auto !important;
}

/* ————————————————————————————————
   3) Optional: add a little padding around slides
———————————————————————————————— */
.jws-pisodes_advanced-item,
.jws-pisodes_advanced-item .post-inner {
  padding: 0.5rem 0 !important;
}




/* ————————————————————————————————
   Universal Video-Carousel Spacing
———————————————————————————————— */
/* 1) Force the owl-stage into one row with a gap */
.jws-video-advance.owl-carousel .owl-stage {
  display:    flex    !important;
  flex-wrap:  nowrap  !important;
  gap:        1rem    !important; /* adjust for more/less spacing */
}

/* ————————————————————————————————
   Universal Carousel Spacing (Games, Episodes & Videos)
———————————————————————————————— */

/* 1) Turn the Owl “stage” into a flex row with gaps */
.jws-pisodes_advanced-slider.owl-carousel .owl-stage,
.jws-video-advance.owl-carousel .owl-stage,
.jws-movie-advance.owl-carousel .owl-stage {
  display:    flex    !important;
  flex-wrap:  nowrap  !important;
  gap:        1rem    !important; /* tweak this value to increase/reduce space */
}



/* 2) Remove Owl’s built-in fixed widths/margins on items */
.jws-pisodes_advanced-slider.owl-carousel .owl-item,
.jws-video-advance.owl-carousel .owl-item,
.jws-movie-advance.owl-carousel .owl-item {
  width:  auto   !important;
  margin: 0      !important;
}

/* 3) (Optional) Add a tiny vertical padding to each “tile” if you like */
.jws-pisodes_advanced-item .post-inner,
.jws-video-advance .video-item,
.jws-movie-advance .movie-item {
  padding: 0.5rem 0 !important;
}





// footer section


/* Target only footer social icons */
footer .elementor-icon i,
footer .elementor-icon svg {
  font-family: 'Font Awesome 5 Free' !important;
  font-weight: 900 !important;
  font-style: normal !important;
}

/* If icons like Facebook, Twitter aren't showing (brand icons) */
footer .elementor-icon.fab {
  font-family: 'Font Awesome 4 Brands' !important;
  font-weight: 400 !important;
}


//


/* Normal state: transparent background */
.elementor-widget-social-icons .elementor-icon {
  background-color: transparent !important;
  border-radius: 50% !important;
  transition: all 0.3s ease-in-out;
}

/* Hover effect: blue glow */
.elementor-widget-social-icons .elementor-icon:hover {
  background-color: rgba(0, 174, 239, 0.1) !important;
  box-shadow: 0 0 10px rgba(0, 174, 239, 0.5) !important;
  border-radius: 50% !important;
}




.pmpro-level-item h6.fs-small.uppercase {
