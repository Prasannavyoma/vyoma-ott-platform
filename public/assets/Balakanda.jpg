  margin-bottom: 4px !important;
  padding: 4px 8px !important;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Avatar adjustments */
.dropdown-menu .user-avatar {
  margin-right: 8px;
}
.dropdown-menu .user-avatar img {
  height: 24px;
  width: 24px;
}

/* Name styling */
.dropdown-menu .post-author h6 {
  margin: 0 !important;
  color: white !important;
  font-size: 14px;
}

/* Nav item link styling */
.dropdown-menu ul.nav li {
  margin: 0;
}
.dropdown-menu ul.nav li a {
  display: block;
  padding: 6px 8px;
  color: white;
  text-decoration: none;
  transition: background 0.3s ease;
	
	
  font-size: 14px;
}

/* Hover effect */
.dropdown-menu ul.nav li a:hover {
  background-color: #0071be !important;
  color: white !important;
}





@media (max-width: 768px) {
  /* Force layout horizontally on mobile */
  .video-play.clear-both {
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 10px !important;
  }

  /* Shrink the Start Watching / Listening button */
  .video-play.clear-both .btn-main.button-default.jws-play {
    padding: 10px 16px !important;
    font-size: 14px !important;
    width: auto !important;
    min-width: 140px !important;
    max-width: 48%;
    flex-shrink: 1;
  }

  /* Style the dropdown to sit beside the button */
  .video-play.clear-both .select-season {
    margin-left: 0 !important;
    width: auto !important;
    max-width: 48%;
    flex-shrink: 1;
  }

  .video-play.clear-both .dropdown-toggle {
    font-size: 14px !important;
    padding: 10px 14px !important;
    width: 100% !important;
  }
}




@media (max-width: 768px) {
  .jws-view-episodes {
    transform: translateX(5px);
    font-size: 16px !important;
    line-height: 1.4 !important;
  }
}




/* Reduce size and style the circular share button */
.single-tv_shows .jws-share a {
    width: 36px !important;
    height: 36px !important;
    background-color: #1e88e5 !important; /* Ensure override */
    border-radius: 50% !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
}

/* Ensure icon inside is centered and colored */
.single-tv_shows .jws-share a i {
    font-size: 19px !important;
}

/* Prevent background color from changing on hover */
.single-tv_shows .jws-share a:hover {
    background-color: #1e88e5 !important;
}






/* Desktop view (default) */
.single-tv_shows .video-play.clear-both {
    position: relative;
}

.single-tv_shows .jws-share {
    position: relative !important;
    margin-top: 10px;
    margin-left: 70px; /* Right side on laptop */
    display: inline-block;
}

/* Mobile and tablet view */
@media (max-width: 1024px) {
    .single-tv_shows .jws-share {
        margin-left: 9px !important; /* Move to left side */
    }
}







/* Also remove the padding/margin from the site-main wrapper in genre */
body.archive .site-main {
    padding-top: 0 !important;
    margin-top: 0 !important;
}

/* Hide excerpt/description only on genre archive pages */
body.tax-genre .jws_post_excerpt {
    display: none !important;
}



/* hide season word */
h6.season {
  display: none !important;
}








/* titlle in a singleline*/
@media (max-width: 480px) {
 
  .elementor-element-f052ff1  h4.elementor-heading-title.elementor-size-default {
    white-space: nowrap;
   
  }


 .elementor-element-168638b h4.elementor-heading-title.elementor-size-default {
	  white-space: nowrap;
   
  }

.elementor-element-d11f55a h4.elementor-heading-title.elementor-size-default {
	  white-space: nowrap;
   
  }
	
.elementor-element-9d26941 h4.elementor-heading-title.elementor-size-default {
	  white-space: nowrap;
   
  }

}



/* profile name hover hiding*/
.post-author a {
  pointer-events: none;
  cursor: default;
  text-decoration: none;
}






/* 2. Remove any background from product-image area Add-ons */
.products-tab.layout1 .product-image {
    background: none !important;
}

/* 3. Position the button container properly */
.products-tab.layout1 .button-inner {
    position: relative !important; /* or absolute if you want overlay */
    margin-top: 20px;
}

/* Move the product-info block slightly upward */
.products-tab.layout1 .product-info {
    margin-top: -40px !important; /* Adjust the value as needed */
    text-align: center;
}





/* Target only page with ID 4214 PRICING PAGE alignmnet */
body.page-id-4214 .row {
    display: flex;
    flex-direction: column;      /* Stack one on top of the other */
    align-items: center;         /* Center horizontally */
    justify-content: center;     /* Optional: Center vertically if needed */
}

/* Optional: Center each column content inside */
body.page-id-4214 .row > .col-xl-6 {
    width: 100%;                 /* Or use a max-width if you want */
    max-width: 600px;            /* Optional: control width */
}

/* soting filter */

.archive-nav .post-select-filter {
  display: flex !important;
  gap: 10px;
  justify-content: flex-end;
}

.post-select-filter option[value="date"] {
  display: none;
}


/* end of sorting filter*/



/* */
/* Remove hand cursor on hover for images inside the specific widget */
.elementor-element-0558b0a .jws_gallery_item a,
.elementor-element-0558b0a .jws_gallery_item a img {
  cursor: default !important;
  pointer-events: none; /* Optional: disables click too */
}


/* removing icon in share modal */

a[href*="plus.google.com"],
a[href*="pinterest.com"] {
    display: none !important;
}



// background colour for forward and backward button
/* Force blue background for nav buttons */
div.global-episodes .owl-nav button.owl-prev,
div.global-episodes .owl-nav button.owl-next {
    background-color: #007bff !important;
    border-radius: 50% !important;
    width: 40px !important;
    height: 40px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
    box-shadow: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    position: relative !important;
    z-index: 999 !important;
}

/* Apply same background to internal span as fallback */
div.global-episodes .owl-nav button.owl-prev span,
div.global-episodes .owl-nav button.owl-next span {
    background-color: #007bff !important;
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border-radius: 100 !important;
}

/* Style the arrow icon */
div.global-episodes .owl-nav button span::before {
    background: transparent !important;
    color: #fff !important;
    font-size: 20px !important;
    line-height: 1 !important;
}


/* carousel container by sapna */







/* end of carousel container by sapna */



fb-description,
.fb-description p {
    font-weight: normal !important;
}





 /* Page-wide: Elementor sometimes sets overflow-x:hidden on the body */
body.elementor-kit-6 { overflow-x: visible !important; }

/* Collection row (Owl Carousel) — stop clipping and add a tail spacer */
body.single-tv_shows .episodes-content.layout3 .owl-carousel,
body.single-tv_shows .episodes-content.layout3 .owl-stage-outer {
  overflow: visible !important;                 /* allow the end to show */
}

/* Create extra width at the far right so the last card can fully scroll into view */
body.single-tv_shows .episodes-content.layout3 .owl-stage::after {
  content: "";
  display: block;
  width: 72px;                                   /* adjust 48–96px if needed */
  height: 1px;                                   /* invisible spacer */
}

/* Remove edge fade/masks that may cover the last card */
body.single-tv_shows .episodes-content.layout3 .jws-pisodes_advanced-slider::before,
body.single-tv_shows .episodes-content.layout3 .jws-pisodes_advanced-slider::after,
body.single-tv_shows .episodes-content.layout3 .owl-carousel::before,
body.single-tv_shows .episodes-content.layout3 .owl-carousel::after {
  display: none !important;
  content: "" !important;
  pointer-events: none !important;
}

