            animation-delay: 0.8s;
        }
        
        .steamvid-google-btn-wrapper.loading {
            position: relative;
            min-height: 45px;
        }
        
        .steamvid-google-btn-wrapper.loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 24px;
            height: 24px;
            margin: -12px 0 0 -12px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #4285f4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            z-index: 10;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes successPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); background: #34a853; }
            100% { transform: scale(1); }
        }
        
        .steamvid-login-success {
            animation: successPulse 0.5s ease;
        }
        
        @media (max-width: 768px) {
            .steamvid-divider {
                margin: 20px 0 15px 0;
            }
            
            .divider-text {
                font-size: 12px;
                padding: 0 15px;
            }
            
            .steamvid-google-btn-wrapper iframe {
                height: 42px !important;
            }
            
            .footer-text {
                font-size: 11px;
                padding: 4px 10px;
            }
        }
        
        @media (prefers-color-scheme: dark) {
            .divider-text {
                background: linear-gradient(90deg, transparent, #1a1a1a 20%, #1a1a1a 80%, transparent);
                color: #aaa;
            }
            
            .steamvid-google-btn-wrapper iframe {
                border-color: rgba(255, 255, 255, 0.1) !important;
            }
            
            .footer-text {
                background: rgba(255, 255, 255, 0.05);
                color: #aaa;
            }
            
            .footer-text:hover {
                background: rgba(255, 255, 255, 0.1);
                color: #ccc;
            }
        }
        
        .steamvid-google-btn-wrapper {
            position: relative;
        }
        
        .steamvid-google-btn-wrapper:hover::before {
            content: '✨ One-click login';
            position: absolute;
            top: -30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: white;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 20px;
            white-space: nowrap;
            opacity: 0;
            animation: fadeInUp 0.3s ease forwards;
            z-index: 100;
            pointer-events: none;
            display: none;
        }
        
        .steamvid-google-btn-wrapper:hover::after {
            content: '';
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            border-left: 5px solid transparent;
            border-right: 5px solid transparent;
            border-top: 5px solid rgba(0, 0, 0, 0.8);
            opacity: 0;
            animation: fadeInUp 0.3s ease forwards;
            pointer-events: none;
            display: none;
        }
        </style>

        <script>
        (function() {
            console.log('🚀 UNIVERSAL Google Login Detector initialized');
            
            // Store processed forms to avoid duplicates
            if (!window.steamvidProcessedForms) {
                window.steamvidProcessedForms = new WeakSet();
            }
            
            // Function to find ALL possible login forms
            function findAllLoginForms() {
                const forms = new Set();
                
                // Method 1: Direct form selectors (your theme's specific classes)
                document.querySelectorAll('form#jws-loginform, form[name="loginpopopform"]').forEach(form => forms.add(form));
                
                // Method 2: Look for forms with password fields
                document.querySelectorAll('input[type="password"]').forEach(input => {
                    const form = input.form || input.closest('form');
                    if (form) forms.add(form);
                });
                
                // Method 3: Look for forms with username/email fields
                document.querySelectorAll('input[name="log"], input[name="username"], input[type="email"]').forEach(input => {
                    const form = input.form || input.closest('form');
                    if (form) forms.add(form);
                });
                
                // Method 4: Look for forms with login-related action
                document.querySelectorAll('form[action*="wp-login"], form[action*="login"]').forEach(form => forms.add(form));
                
                // Method 5: Look inside popup containers
                document.querySelectorAll('.jws-form-login-popup, .modal, .popup, [class*="login"]').forEach(container => {
                    const form = container.querySelector('form');
                    if (form) forms.add(form);
                });
                
                return Array.from(forms);
            }
            
            // Function to check if a form is a login form
            function isLoginForm(form) {
                // Check for password field
                if (form.querySelector('input[type="password"], input[name="pwd"]')) {
                    return true;
                }
                
                // Check for username/email field AND submit button
                const hasUsername = form.querySelector('input[name="log"], input[name="username"], input[type="email"]');
                const hasSubmit = form.querySelector('input[type="submit"], button[type="submit"]');
                
                return hasUsername && hasSubmit;
            }
            
            // Main function to inject Google button into login forms
            function injectGoogleButton(loginForm) {
                // Skip if already processed
                if (window.steamvidProcessedForms.has(loginForm)) {
                    return false;
                }
                
                // Double-check it's a login form
                if (!isLoginForm(loginForm)) {
                    return false;
                }
                
                // Check if Google button already exists in this form
                if (loginForm.querySelector('.steamvid-social-login')) {
                    window.steamvidProcessedForms.add(loginForm);
                    return true;
                }
                
                console.log('✅ Found login form, injecting Google button');
                
                // Get template
                const template = document.getElementById('steamvid-google-template');
                if (!template) return false;
                
                // Clone template
                const googleSection = template.content.cloneNode(true);
                
                // Find the submit button
                const submitButton = loginForm.querySelector('input[type="submit"], button[type="submit"]');
                
                if (submitButton) {
                    // Find the best insertion point - BEFORE the submit button
                    const submitParent = submitButton.closest('.submit, .jws-button, .form-row, p, div');
                    
                    if (submitParent && submitParent.parentNode) {
                        // Insert BEFORE the submit button's container
                        submitParent.parentNode.insertBefore(googleSection, submitParent);
                        console.log('✅ Inserted BEFORE submit button');
                    } else {
                        // Fallback: insert before the submit button itself
                        submitButton.parentNode.insertBefore(googleSection, submitButton);
                        console.log('✅ Inserted BEFORE submit button (direct)');
                    }
                } else {
                    // If no submit button, insert at the end of form
                    loginForm.appendChild(googleSection);
                    console.log('✅ Appended to form');
                }
                
                // Mark as processed
                window.steamvidProcessedForms.add(loginForm);
                
                // Render Google button
                setTimeout(() => {
                    renderGoogleButton(loginForm);
                }, 200);
                
                return true;
            }
            
            // Function to render the actual Google button
            function renderGoogleButton(form) {
                if (typeof google === 'undefined' || !google.accounts) {
                    console.log('⏳ Google not ready, retrying...');
                    setTimeout(() => renderGoogleButton(form), 500);
                    return;
                }
                
                // Find the placeholder in this specific form
                const placeholder = form.querySelector('.steamvid-google-btn-placeholder');
                if (!placeholder) return;
                
                console.log('🎨 Rendering Google button');
                
                // Add loading state
                const wrapper = placeholder.closest('.steamvid-google-btn-wrapper');
                if (wrapper) wrapper.classList.add('loading');
                
                // Calculate width based on form
                const formWidth = form.offsetWidth || 400;
                const buttonWidth = Math.min(formWidth - 60, 320);
                
                // Initialize Google Sign-In
                google.accounts.id.initialize({
                    client_id: '303172867377-36q0ogapllrcrfhp9d02ud6f8rp57igu.apps.googleusercontent.com',
                    callback: handleGoogleLogin,
                    auto_select: false,
                    cancel_on_tap_outside: true
                });
                
                // Render button
                google.accounts.id.renderButton(
                    placeholder,
                    { 
                        theme: 'outline', 
                        size: 'large', 
                        text: 'continue_with',
                        shape: 'pill',
                        logo_alignment: 'center',
                        width: buttonWidth
                    }
                );
                
                // Remove loading state
                setTimeout(() => {
                    if (wrapper) wrapper.classList.remove('loading');
                }, 500);
                
                console.log('✅ Google button rendered');
            }
            
            // Handle Google login response
            function handleGoogleLogin(response) {
                console.log('✅ Google login response received');
                
                fetch('https://floralwhite-marten-419677.hostingersite.com/wp-admin/admin-ajax.php', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        action: 'steamvid_google_auth',
                        credential: response.credential
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('✓ Login successful! Redirecting...', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    } else {
                        showNotification('✗ Login failed. Please try again.', 'error');
                    }
                })
                .catch(error => {
                    console.error('❌ Login error:', error);
                    showNotification('✗ Connection error. Please try again.', 'error');
                });
            }
            
            // Show notification
            function showNotification(message, type) {
                const notification = document.createElement('div');
                notification.style.cssText = `
                    position: fixed;
                    top: 30px;
                    right: 30px;
                    padding: 14px 24px;
                    background: ${type === 'success' ? '#34a853' : '#ea4335'};
                    color: white;
                    border-radius: 50px;
                    font-size: 14px;
                    font-weight: 500;
                    z-index: 999999;
                    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
                    opacity: 0;
                    transform: translateX(30px);
                    animation: slideIn 0.4s ease forwards;
                `;
                notification.textContent = message;
                document.body.appendChild(notification);
                
                setTimeout(() => {
                    notification.style.animation = 'slideOut 0.3s ease forwards';
                    setTimeout(() => notification.remove(), 300);
                }, 3000);
            }
            
            // Add CSS animations
            if (!document.getElementById('steamvid-notification-styles')) {
                const style = document.createElement('style');
                style.id = 'steamvid-notification-styles';
                style.textContent = `
                    @keyframes slideIn {
                        to { opacity: 1; transform: translateX(0); }
                    }
                    @keyframes slideOut {
                        to { opacity: 0; transform: translateX(30px); }
                    }
                `;
                document.head.appendChild(style);
            }
            
            // Function to scan for login forms
            function scanForLoginForms() {
                console.log('🔍 Scanning for login forms...');
                const forms = findAllLoginForms();
                forms.forEach(form => {
                    if (isLoginForm(form)) {
                        injectGoogleButton(form);
                    }
                });
            }
            
            // Set up mutation observer to detect when popup is added
            const observer = new MutationObserver(function(mutations) {
                let shouldScan = false;
                
                mutations.forEach(function(mutation) {
                    // Check added nodes
                    if (mutation.addedNodes.length > 0) {
                        mutation.addedNodes.forEach(node => {
                            if (node.nodeType === 1) {
                                // Check if this is the login popup
                                if (node.classList && node.classList.contains('jws-form-login-popup')) {
                                    console.log('🎯 Login popup detected!');
                                    shouldScan = true;
                                }
                                
                                // Check for forms inside added nodes
                                if (node.querySelectorAll) {
                                    const forms = node.querySelectorAll('form');
                                    if (forms.length > 0) shouldScan = true;
                                }
                            }
                        });
                    }
                    
                    // Check for class changes (popup opening)
                    if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                        if (mutation.target.classList && 
                            mutation.target.classList.contains('jws-form-login-popup') &&
                            mutation.target.classList.contains('open')) {
                            console.log('🎯 Login popup opened!');
                            shouldScan = true;
                        }
                    }
                });
                
                if (shouldScan) {
                    setTimeout(scanForLoginForms, 200);
                }
            });
            
            // Start observing
            observer.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['class', 'style']
            });
            
            // Hook into ALL possible login triggers
            function setupTriggers() {
                // Click on account dropdown
                document.addEventListener('click', function(e) {
                    const target = e.target.closest('.jws_account, .jws-open-login, a[href*="login"], button:contains("Login"), button:contains("Register")');
                    if (target) {
                        console.log('👆 Login trigger clicked');
                        setTimeout(scanForLoginForms, 300);
                    }
                }, true);
                
                // Check for keyboard shortcuts
                document.addEventListener('keydown', function(e) {
                    // Check for any key that might trigger login popup
                    setTimeout(scanForLoginForms, 300);
                });
                
                // Check for focus on any input that might be in a login form
                document.addEventListener('focusin', function(e) {
                    if (e.target.matches('input[type="password"], input[name="log"], input[name="username"]')) {
                        console.log('👆 Login input focused');
                        setTimeout(scanForLoginForms, 200);
                    }
                }, true);
            }
            
            // Also check when the DOM is fully loaded
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    scanForLoginForms();
                    setupTriggers();
                });
            } else {
                scanForLoginForms();
                setupTriggers();
            }
            
            // Check periodically for 20 seconds
            let attempts = 0;
            const interval = setInterval(function() {
                scanForLoginForms();
                attempts++;
                if (attempts > 20) {
                    clearInterval(interval);
                    console.log('⏹️ Stopped periodic scanning');
                }
            }, 1000);
            
            // Check when page becomes visible (user returns to tab)
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden) {
                    console.log('👁️ Page became visible, scanning...');
                    scanForLoginForms();
                }
            });
            
            console.log('✅ Universal Google Login detector ready');
        })();
        </script>
            <script>
    (function () {
        var PATTERN = /Your current membership level[\s\S]{0,300}?will be removed when you complete your purchase\.?/gi;

        function scrub( root ) {
            if ( ! root || typeof root.querySelectorAll !== 'function' ) return;
            root.querySelectorAll( 'p, li, span, div' ).forEach( function ( el ) {
                if ( el.children.length > 0 ) return;
                var text = el.innerText || el.textContent || '';
                PATTERN.lastIndex = 0;
                if ( PATTERN.test( text ) ) {
                    PATTERN.lastIndex = 0;
                    el.innerText = text.replace( PATTERN, '' ).trim();
                }
            });
        }

        document.addEventListener( 'DOMContentLoaded', function () {
            scrub( document.body );
            new MutationObserver( function ( mutations ) {
                mutations.forEach( function ( m ) {
                    m.addedNodes.forEach( function ( node ) {
                        if ( node.nodeType === 1 ) scrub( node );
                    });
                });
            }).observe( document.body, { childList: true, subtree: true } );
        });
    }());
    </script>
        <script>
    (function () {
        var P = /Your current membership level[\s\S]{0,300}?will be removed when you complete your purchase\.?/gi;
        function scrub( root ) {
            if ( ! root || ! root.querySelectorAll ) return;
            root.querySelectorAll( 'p,li,span,div' ).forEach( function(el) {
                if ( el.children.length ) return; // leaf nodes only
                var t = el.innerText || el.textContent || '';
                P.lastIndex = 0;
                if ( P.test(t) ) {
                    P.lastIndex = 0;
                    el.innerText = t.replace( P, '' ).trim();
                }
            });
        }
        document.addEventListener( 'DOMContentLoaded', function () {
            scrub( document.body );
            new MutationObserver( function(ms) {
                ms.forEach( function(m) {
                    m.addedNodes.forEach( function(n) {
                        if ( n.nodeType === 1 ) scrub(n);
                    });
                });
            }).observe( document.body, { childList: true, subtree: true });
        });
    }());
    </script>
