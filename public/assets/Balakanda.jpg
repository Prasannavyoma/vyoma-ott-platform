      // WhatsApp icon (Font Awesome)
      whatsappLink.innerHTML = '<i class="fab fa-whatsapp" style="font-size: 18px; color: #FFFFFF;"></i>';
      // Append to share container
      shareContainer.appendChild(whatsappLink);
    }
  }, 400);
});
