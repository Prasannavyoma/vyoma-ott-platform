	<!-- Hide Theme’s Default Search Dropdown -->
<style>
  .search-results-wrapper,
  .jws-search-results {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>

<script>
(function waitForSearchBar() {
  
  // Check every 300ms until header is loaded
  const el = document.querySelector(".s");
  if (!el) {
    return setTimeout(waitForSearchBar, 300);
  }

  console.log("Search bar FOUND — activating dropdown blocker");

  function hideDropdown() {
    document.querySelectorAll(".search-results-wrapper, .jws-search-results")
      .forEach(w => w.style.display = "none");
  }

  // Hide immediately
  hideDropdown();

  // Bind after load
  el.addEventListener("input", hideDropdown);
  el.addEventListener("focus", hideDropdown);

  // Extra safety: catch theme scripts loaded late
  new MutationObserver(hideDropdown).observe(document.body, {
    subtree: true,
    childList: true
  });

})();
</script>






















    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const categoryHeadings = {
            "term-gblgame-based-learning": "Game-based Learning",
            "term-e-book": "E-Books",
            "term-video": "Videos",
            "term-audio-book": "Audiobooks",
            "term-games": "Games",
            "term-learning-program": "Learning Programs",
            "term-podcast": "Podcasts"
        };

        function insertCategoryHeading() {
            const bodyClasses = document.body.classList;
            let matchedClass = null;

            for (const cls of bodyClasses) {
                if (categoryHeadings.hasOwnProperty(cls)) {
                    matchedClass = cls;
                    break;
                }
            }

            if (!matchedClass) return;

            const headingText = categoryHeadings[matchedClass];

            // Avoid duplicate titles
            if (document.querySelector('.custom-category-heading')) return;

            let container = document.querySelector(".site-main .container .row");
            if (!container) container = document.querySelector(".site-main");

            if (container) {
                const wrapper = document.createElement("div");
                wrapper.className = "custom-category-heading";
                wrapper.style.width = "100%";
                wrapper.style.marginBottom = "20px";

                const heading = document.createElement("h1");
                heading.textContent = headingText;
                heading.style.textAlign = "left";
                heading.style.color = "white";
                heading.style.fontSize = "36px";

                wrapper.appendChild(heading);
                container.parentElement.insertBefore(wrapper, container);
            }
        }

        function insertBhagavadGitaSlide() {
            if (!document.body.classList.contains("term-multimedia")) return;

            const owlStage = document.querySelector(".owl-stage");
            if (owlStage) {
                // Avoid duplicate slide
                if (document.querySelector('.owl-item-inner img[src*="gita-thumb.jpg"]')) return;

                const newSlide = document.createElement("div");
                newSlide.className = "owl-item";
                newSlide.innerHTML = `
                    <div class="owl-item-inner" style="padding:10px; background:#f1f1f1; text-align:center;">
                        <a href="https://floralwhite-marten-419677.hostingersite.com/audio/srimadbhagavadgita-2/" style="text-decoration:none; color:#000;">
                            <img src="https://floralwhite-marten-419677.hostingersite.com/wp-content/uploads/2023/11/gita-thumb.jpg" alt="Srimad Bhagavad Gita" style="max-width: 100%; height: auto;"/>
                            <h2 style="margin-top:10px; font-weight:bold;">Srimad Bhagavad Gita</h2>
                            <p>Video</p>
                        </a>
                    </div>
                `;
                owlStage.appendChild(newSlide);

                // Refresh Owl Carousel
                if (typeof jQuery !== "undefined" && jQuery(".owl-carousel").data('owl.carousel')) {
                    jQuery(".owl-carousel").trigger('add.owl.carousel', [newSlide]).trigger('refresh.owl.carousel');
                    console.log("✅ Bhagavad Gita slide added and carousel refreshed.");
                } else {
                    console.warn("⚠️ Owl Carousel jQuery plugin not found or not initialized.");
                }
            } else {
                console.warn("❌ Owl Carousel container (.owl-stage) not found on Multimedia page.");
            }
        }

        // Initial execution
        insertCategoryHeading();
        insertBhagavadGitaSlide();

        // Elementor popup or frontend initialization
        jQuery(document).on('elementor/popup/show elementor/frontend/init', function () {
            setTimeout(() => {
                insertCategoryHeading();
                insertBhagavadGitaSlide();
            }, 300);
        });

        // MutationObserver fallback
        const observer = new MutationObserver(() => {
            insertCategoryHeading();
            insertBhagavadGitaSlide();
        });
        observer.observe(document.body, { childList: true, subtree: true });
    });
    </script>
        <script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkExist = setInterval(function () {
            const headings = document.querySelectorAll('.jws-episodes-heading .heading');
            const links = document.querySelectorAll('.jws-view-episodes');

            let headingChanged = false;
            let linkChanged = false;

            // Change 'Episodes' to 'Collection' in headings
            headings.forEach(function (heading) {
                if (heading.textContent.trim() === "Episodes") {
                    heading.textContent = "Collection";
                    headingChanged = true;
                }
            });

            // Change 'All Episodes' to 'All Collections' in links
            links.forEach(function (link) {
                if (link.textContent.trim() === "All Episodes") {
                    link.textContent = "All Collections";
                    linkChanged = true;
                }
            });

            // Replace all text nodes with 'Episodes' to 'Collection'
            const treeWalker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        return node.nodeValue.match(/Episodes/i) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
                    }
                },
                false
            );

            while(treeWalker.nextNode()) {
                treeWalker.currentNode.nodeValue = treeWalker.currentNode.nodeValue.replace(/Episodes/g, 'Collection');
            }

            // Stop checking once changes are made
            if (headingChanged && linkChanged) {
                clearInterval(checkExist);
            }
        }, 300);
    });
    </script>
