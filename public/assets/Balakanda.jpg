	<style id="hard-no-copy-rightclick">
  /* No selection/copy everywhere except explicit opt-ins */
  html, body, body *:not(input):not(textarea):not([contenteditable="true"]):not(.allow-select) {
    -webkit-user-select: none !important;
       -moz-user-select: none !important;
        -ms-user-select: none !important;
            user-select: none !important;
  }
  /* Reduce touch callout / drag on common media */
  img, video, audio, iframe, canvas {
    -webkit-touch-callout: none !important;
    -webkit-user-drag: none !important;
    user-drag: none !important;
  }
</style>

<script id="hard-no-copy-rightclick-js">
(function () {
  // Some themes or plugins rebind handlers; use capture + stopImmediatePropagation.
  function kill(e){
    if (!e) return false;
    e.preventDefault();
    try { e.stopImmediatePropagation(); } catch(_) {}
    try { e.stopPropagation(); } catch(_) {}
    return false;
  }

  // 1) Block context menu, aux/middle, right button, and double-click globally
  ['contextmenu','auxclick','mousedown','mouseup','dblclick'].forEach(function(type){
    document.addEventListener(type, function(e){
      // block any context menu
      if (type === 'contextmenu') return kill(e);
      // right button or non-left aux clicks
      if ((e.button === 2) || (type === 'auxclick' && e.button !== 0)) return kill(e);
      // double-click
      if (type === 'dblclick') return kill(e);
    }, { capture:true, passive:false });
  });

  // 2) Block selection/copy/cut/drag everywhere (allow explicit opt-ins)
  ['selectstart','copy','cut','dragstart'].forEach(function(type){
    document.addEventListener(type, function(e){
      var t = e.target;
      if (t && t.closest('input, textarea, [contenteditable="true"], .allow-select')) return;
      return kill(e);
    }, { capture:true, passive:false });
  });

  // 3) Harden media nodes we can reach (same origin DOM)
  function harden(node){
    if (!node) return;
    try {
      node.setAttribute('oncontextmenu','return false');
      node.setAttribute('draggable','false');
      // extra hints for HTML5 media
      if (node.tagName === 'VIDEO' || node.tagName === 'AUDIO') {
        var cl = (node.getAttribute('controlsList') || '');
        if (!/nodownload/.test(cl)) cl += ' nodownload';
        if (!/noremoteplayback/.test(cl)) cl += ' noremoteplayback';
        node.setAttribute('controlsList', cl.trim());
        node.setAttribute('disablepictureinpicture','');
      }
    } catch(_) {}
  }
  function applyAll(){
    document.querySelectorAll('img, video, audio, iframe, canvas').forEach(harden);
  }
  applyAll();

  // 4) Re-apply for dynamically inserted content
  new MutationObserver(applyAll).observe(document.documentElement, { childList:true, subtree:true });

  // 5) Re-arm contextmenu periodically in case another script removes our handler
  setInterval(function(){
    document.addEventListener('contextmenu', kill, { capture:true });
  }, 1500);
})();
</script>
