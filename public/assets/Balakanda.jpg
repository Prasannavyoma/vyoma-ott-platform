        @keyframes gentlePulse {
            0% { box-shadow: 0 2px 12px rgba(66, 133, 244, 0.08); }
            50% { box-shadow: 0 4px 18px rgba(66, 133, 244, 0.2); }
            100% { box-shadow: 0 2px 12px rgba(66, 133, 244, 0.08); }
        }
        
