        <script>
    function toggleCollectionVisibility() {
        document.querySelectorAll('.jws-episodes_advanced-element').forEach(function (section) {
            const cards = section.querySelectorAll('.episodes-content .jws-pisodes_advanced-item');
            const heading = section.querySelector('.jws-episodes-heading');
            const viewAll = section.querySelector('.jws-view-episodes');

            if (cards.length <= 1) {
                if (heading) heading.style.display = 'none';
                if (viewAll) viewAll.style.display = 'none';
            } else {
                if (heading) heading.style.display = 'block';
                if (viewAll) viewAll.style.display = 'inline-block';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        toggleCollectionVisibility();

        // Hook into Owl Carousel re-init
        if (typeof jQuery !== 'undefined' && typeof jQuery.fn.owlCarousel === 'function') {
            jQuery('.episodes-content.owl-carousel').on('initialized.owl.carousel refreshed.owl.carousel', function () {
                toggleCollectionVisibility();
            });
        }

        // Recheck on dropdown interaction
        document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(function (item) {
            item.addEventListener('click', function () {
                setTimeout(toggleCollectionVisibility, 700);
            });
        });
    });
    </script>
