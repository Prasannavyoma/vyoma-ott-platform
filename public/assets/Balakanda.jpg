        <div id="honor-wrap" style="display:none; margin:20px 0 16px; padding:16px 20px;
         border:2px solid #5b8dee; border-radius:8px; background:rgba(91,141,238,0.08);">

        <p style="margin:0 0 14px; font-weight:700; font-size:14px; color:#fff;">
            &#9989; Honor Code Declaration
        </p>

        <!-- Indian user: checkbox + declaration text -->
        <label id="honor-in" style="display:none; align-items:flex-start; gap:10px;
               cursor:pointer; font-size:13px; color:#ddd;">
            <input type="checkbox" name="indian_user_declaration" id="cb_in" value="yes"
                   style="width:16px;height:16px;margin-top:2px;flex-shrink:0;cursor:pointer;accent-color:#5b8dee;" />
            <span>I am an Indian user</span>
        </label>

        <p id="honor-in-text" style="display:none; margin:10px 0 0 26px; font-size:12px;
           color:#aaa; font-style:italic; line-height:1.6;">
            I hereby confirm that I am residing in the territory of India and all transactions undertaken shall be executed in Indian Rupees (INR).
        </p>

        <!-- NON-Indian user: checkbox -->
        <label id="honor-non" style="display:none; align-items:flex-start; gap:10px;
               cursor:pointer; font-size:13px; color:#ddd;">
            <input type="checkbox" name="non_indian_user_declaration" id="cb_non" value="yes"
                   style="width:16px;height:16px;margin-top:2px;flex-shrink:0;cursor:pointer;accent-color:#5b8dee;" />
            <span>I hereby confirm that I am residing outside the territory of India and all transactions undertaken shall be executed in the currency of my country of residence.</span>
        </label>

        <p id="honor-error" style="display:none; margin:10px 0 0; color:#ff4d4d;
           font-size:12px; font-weight:600;">
            ⚠️ This field is required. Please tick the checkbox above.
        </p>

        <p id="honor-ph" style="display:none; margin:0 0 0; font-size:12px; color:#aaa; font-style:italic;">
            Please select your country above.
        </p>
    </div>

    <script>
    (function(){
        var wrap      = document.getElementById('honor-wrap');
        var lIn       = document.getElementById('honor-in');
        var inText    = document.getElementById('honor-in-text');
        var lNon      = document.getElementById('honor-non');
        var ph        = document.getElementById('honor-ph');
        var cbIn      = document.getElementById('cb_in');
        var cbNon     = document.getElementById('cb_non');
        var errMsg    = document.getElementById('honor-error');
        var inserted  = false; /* track DOM insertion separately */

        function showError() {
            errMsg.style.display = 'block';
            wrap.style.borderColor = '#ff4d4d';
            wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        function hideError() {
            errMsg.style.display = 'none';
            wrap.style.borderColor = '#5b8dee';
        }

        cbIn.addEventListener('change',  hideError);
        cbNon.addEventListener('change', hideError);

        var lastCode = '__INIT__';

        function setCountry(code) {
            code = (code || '').toUpperCase().trim();
            if (!/^[A-Z]{2}$/.test(code)) code = '';
            if (code === lastCode) return;
            lastCode = code;

            cbIn.checked  = false;
            cbNon.checked = false;
            hideError();

            if (code === '') {
                wrap.style.display   = 'none';
                lIn.style.display    = 'none';
                inText.style.display = 'none';
                lNon.style.display   = 'none';
                ph.style.display     = 'block';
            } else if (code === 'IN') {
                wrap.style.display   = 'block';
                lIn.style.display    = 'flex';
                inText.style.display = 'block';
                lNon.style.display   = 'none';
                ph.style.display     = 'none';
            } else {
                wrap.style.display   = 'block';
                lIn.style.display    = 'none';
                inText.style.display = 'none';
                lNon.style.display   = 'flex';
                ph.style.display     = 'none';
            }
        }

        function findCountrySelect() {
            var s = document.querySelector('select[name="bcountry"]') ||
                    document.querySelector('select[id="bcountry"]');
            if (s) return s;
            var all = document.querySelectorAll('select');
            for (var i = 0; i < all.length; i++) {
                var n = (all[i].name || '').toLowerCase();
                var d = (all[i].id   || '').toLowerCase();
                if (n.indexOf('country') > -1 || d.indexOf('country') > -1) return all[i];
            }
            for (var j = 0; j < all.length; j++) {
                var o = all[j].options;
                if (o.length > 100 && o[1] && /^[A-Z]{2}$/i.test(o[1].value)) return all[j];
            }
            return null;
        }

        function getCountryCode() {
            var s = findCountrySelect();
            return s ? (s.value || '') : '';
        }

        function attachObserver(sel) {
            if (!sel || sel._honorObserved) return;
            sel._honorObserved = true;
            var observer = new MutationObserver(function() {
                setCountry(getCountryCode());
            });
            observer.observe(sel, { attributes: true, childList: true, subtree: true });
            if (sel.parentNode) {
                observer.observe(sel.parentNode, { attributes: true, childList: true, subtree: true });
            }
        }

        var tried = 0;
        function init() {
            tried++;
            if (tried > 40) return;

            var phone =
                document.querySelector('#bphone') ||
                document.querySelector('input[name="bphone"]') ||
                document.querySelector('input[id*="phone"]');

            if (!phone) { setTimeout(init, 300); return; }

            /* ── Insert wrap into DOM only once ── */
            if (!inserted) {
                var row =
                    phone.closest('.pmpro_checkout-field') ||
                    phone.closest('fieldset')              ||
                    phone.parentNode.parentNode            ||
                    phone.parentNode;

                row.parentNode.insertBefore(wrap, row.nextSibling);
                inserted = true;
            }

            /* ── Set initial country AFTER insertion ── */
            setCountry(getCountryCode());

            var sel = findCountrySelect();
            if (sel) {
                ['change', 'input', 'chosen:updated', 'select2:select',
                 'select2:close', 'chosen:hiding_dropdown'].forEach(function(evt) {
                    sel.addEventListener(evt, function() { setCountry(getCountryCode()); });
                });
                attachObserver(sel);
            }

            /* Poll every 200ms for 30s then slow to 2s */
            var pollCount = 0;
            var pollMax   = 150;
            var pollTimer = setInterval(function() {
                setCountry(getCountryCode());
                if (++pollCount >= pollMax) {
                    clearInterval(pollTimer);
                    setInterval(function() { setCountry(getCountryCode()); }, 2000);
                }
            }, 200);

            /* MANDATORY VALIDATION */
            var submitBtn = document.querySelector(
                '#pmpro_btn-submit, input[name="submit-checkout"], button[type="submit"]'
            );
            var form = phone.closest('form');

            function validateHonor(e) {
                var inV  = lIn.style.display  !== 'none';
                var nonV = lNon.style.display !== 'none';
                if ((inV && !cbIn.checked) || (nonV && !cbNon.checked)) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    showError();
                    return false;
                }
            }

            if (submitBtn) submitBtn.addEventListener('click',  validateHonor, true);
            if (form)      form.addEventListener('submit', validateHonor, true);
        }

        document.readyState === 'loading'
            ? document.addEventListener('DOMContentLoaded', init)
            : init();

        /* ── on load: re-run init only if not inserted yet ── */
        window.addEventListener('load', function() {
            if (!inserted) init();
            else setCountry(getCountryCode());
        });

    })();
    </script>
        <script src="https://cdn.jsdelivr.net/npm/meilisearch@latest/dist/bundles/meilisearch.umd.min.js"></script>
    <script>
      const client = new MeiliSearch({
        host: 'https://search.floralwhite-marten-419677.hostingersite.com',
        apiKey: '8600b7a424d3b9d362829f7b8d7d40bc9dc834ee6c2241d745677eeca2a9e1fe'
      });

      const indexes = [
        'addonsfinal',
        'audiosfinal',
        'ebooksfinal',
        'gamesfinal',
        'multimediafinal',
        'podcastsfinal',
        'videosfinal'
      ];

      async function performSearch(query) {
        let allResults = [];

        for (const index of indexes) {
          const result = await client.index(index).search(query);
          const taggedHits = result.hits.map(hit => ({
            ...hit,
            _source_index: index
          }));
          allResults = allResults.concat(taggedHits);
        }

        const resultsDiv = document.getElementById("search-results");
        if (resultsDiv) {
          resultsDiv.innerHTML = allResults.length
            ? allResults.map(r =>
                `<div style="padding:4px 0;"><strong>[${r._source_index}]</strong> ${r.title || r.name || r.id}</div>`
              ).join('')
            : '<em>No results found</em>';
        }
      }

      document.querySelector('.s')?.addEventListener('input', function(e) {
        const query = e.target.value.trim();
        if (query.length >= 2) {
          performSearch(query);
        } else {
          document.getElementById("search-results")?.innerHTML = '';
        }
      });
    </script>

