        <script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".post-media").forEach(function (mediaDiv) {
            // Skip if already wrapped
            if (mediaDiv.parentElement.tagName.toLowerCase() === 'a') return;

            // Get the inner <a> tag's href (usually wrapping the <img>)
            const innerAnchor = mediaDiv.querySelector('a');
            if (innerAnchor) {
                const videoURL = innerAnchor.getAttribute('href');

                // Create new anchor
                const wrapperAnchor = document.createElement('a');
                wrapperAnchor.href = videoURL;
                wrapperAnchor.className = 'post-media-link-wrapper';
                wrapperAnchor.style.display = 'block'; // ensure block to wrap the div properly

                // Clone and insert
                mediaDiv.parentNode.insertBefore(wrapperAnchor, mediaDiv);
                wrapperAnchor.appendChild(mediaDiv);
            }
        });
    });
    </script>
