			<style class="wpcode-css-snippet">/* ===============================
   Full card UI styles
   =============================== */

.meili-card {
  position: relative;
  background-color: #0b1f3a;
  color: white;
  border-radius: 8px;
  border: 1px solid #ddd;
  padding: 1.1rem 1rem 0.9rem;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  height: 350px;
  overflow: hidden;
}

/* Title */
.meili-card h3 {
  font-size: 1rem;
  color: #ffffff;
  margin-bottom: 0.4rem;
  padding-top: 0.4rem;
}

/* ===============================
   Snippet area (CRITICAL FIX)
   =============================== */

.meili-card p {
  font-size: 0.88rem;
  color: #c0ccee;
  line-height: 1.45;
  margin-top: 0.2rem;

  /* 👇 THIS RESTORES OLD BEHAVIOR */
  max-height: 170px;
  overflow-y: auto;

  padding-right: 6px;
}

/* Prevent injected HTML from breaking layout */
.meili-card p * {
  all: unset;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

/* ===============================
   Badge & divider
   =============================== */

.meili-badge {
  display: inline-block;
  background-color: #0050a0;
  color: white;
  font-size: 0.55rem;
  padding: 2px 6px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-bottom: 0.35rem;
}

.meili-divider {
  height: 1.5px;
  background-color: #3d567a;
  margin: 0.5rem 0;
  opacity: 0.8;
}

/* ===============================
   Page label (matches old UI)
   =============================== */

.page-label {
  display: block;
  margin: 6px 0 2px;
  font-size: 0.7rem;
  font-weight: 600;
  color: gold;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

/* ===============================
   Highlight
   =============================== */

mark {
  background-color: #ffd54f;
  color: #0b1f3a;
  padding: 0 2px;
  border-radius: 3px;
  font-weight: 600;
}

/* ===============================
   View Full button (PINNED)
   =============================== */

.view-full-btn {
  margin-top: auto;               /* 👈 pins to bottom */
  align-self: stretch;
  text-align: center;

  background: linear-gradient(90deg, #0072c6, #0050a0);
  border: none;
  color: white;
  padding: 7px 0;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 600;
}

.view-full-btn:hover {
  opacity: 0.9;
}

/* ===============================
   Scrollbar inside snippet
   =============================== */

.meili-card p::-webkit-scrollbar {
  width: 5px;
}

.meili-card p::-webkit-scrollbar-thumb {
  background-color: #888;
  border-radius: 4px;
}

.meili-card p::-webkit-scrollbar-track {
  background: transparent;
}

/* ===============================
   Result info
   =============================== */

#meili-result-info {
  display: none;
  margin-top: 10px;
  text-align: right;
  color: #ddd;
  font-size: 0.9rem;
  font-weight: 500;
  padding-right: 8px;
}

#meili-result-info .filter-icon {
  margin-left: 8px;
  font-size: 0.9rem;
  color: gold;
}

/* ===============================
   Overlay
   =============================== */

#meili-overlay-inner h2 {
  margin-bottom: 10px;
  color: #fff;
}

/* ===============================
   Loader dots (unchanged)
   =============================== */

.searchsubmit i {
  animation: none !important;
  transform: none !important;
}

.loader-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4px;
}

.loader-dots div {
  width: 4px;
  height: 4px;
  background-color: gold;
  border-radius: 50%;
  animation: dot-blink 1s infinite;
}

@keyframes dot-blink {
  0%, 80%, 100% {
    opacity: 0.2;
    transform: scale(1);
  }
  40% {
    opacity: 1;
    transform: scale(1.4);
  }
}
/* ===============================
   Content snippet (RESTORED)
   =============================== */

.meili-snippet {
  font-size: 0.88rem;
  color: #c0ccee;
  line-height: 1.45;

  max-height: 160px;
  overflow-y: auto;

  padding-right: 6px;
}

/* Prevent content HTML from leaking styles */
.meili-snippet * {
  all: unset;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

/* Page labels inside snippet */
.meili-snippet .page-label {
  display: block;
  margin: 6px 0 2px;
  font-size: 0.7rem;
  font-weight: 600;
  color: gold;
  text-transform: uppercase;
}
/* ===============================
   Internal scrolling for content cards
   =============================== */

/* Fix card height (already matches your design) */
.meili-card {
  height: 350px;
  display: flex;
  flex-direction: column;
}

/* Make ONLY the snippet scroll */
.meili-card p {
  flex: 1 1 auto;        /* takes remaining space */
  overflow-y: auto;      /* internal scroll */
  padding-right: 6px;
}

/* Ensure button never scrolls away */
.meili-card .view-full-btn {
  flex-shrink: 0;
  margin-top: 6px;
}
</style>		<style type="text/css" id="wp-custom-css">
			/* Flex display for larger screens */
.elementor-logo img, .logo-inner img{
	height: 100% !important ;
	max-height : 100% !important ;
}

.elementor-element.elementor-element-25ccc12 .elementor-widget-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: nowrap;
}

/* Horizontal menu layout */
.jws_main_menu_inner ul.nav {
  display: flex;
  gap: 20px;
}

/* Mobile/Tablet Responsiveness */
@media (max-width: 768px) {
  /* Stack logo and nav in a column on small screens */
  .elementor-element.elementor-element-25ccc12 .elementor-widget-wrap {
    flex-direction: column;
    align-items: center;
  }
  
  /* Stack the navigation items vertically */
  .jws_main_menu_inner ul.nav {
    flex-direction: column;
    gap: 10px;
  }
  
  /* Adjust logo size for smaller screens */
  .elementor-logo img {
    width: 120px; /* Resize logo as needed */
    height: auto;
  }
}
.vjs-playback-rate-value {
	z-index:4;
}

/* Top 10 products CSS */


.top-videos-inner {
    position: relative;
    padding: 0;
    margin: 0;
}

.top-videos-item.slider-item {
    flex: 1 1 auto;
    width: auto !important;
    max-width: 100% !important;
    padding: 5px;
}


/* Image fills the entire space */
.top-videos-inner img.attachment-full {
    width: 100% !important;       /* Makes image take full width of its container */
    height: auto !important;      /* Maintains aspect ratio */
    max-width: 100% !important;   /* Prevents default limiting */
    transform: scale(1.1);        /* Slight zoom effect */
}
/*number poiationing*/
.top-videos-inner .top-number {
    position: absolute;
    font-size: 68px !important;
    bottom: 0;
    left: 100%;
    transform: translateX(65px) translateY(60px);
    color: #0071be !important;
    line-height: 1;
    z-index: ;
    pointer-events: none;
}


.top-videos-inner .top-number {
  font-family: 'Futura Display', sans-serif !important;
  font-weight: 300 !important;
}

/* Media query for mobile */
@media (max-width: 480px) {
    .top-videos-inner .top-number {
        font-size: 68px !important;
        bottom: 8px;
        left: 8px;
    }

    .top-videos-inner img.attachment-full {
        transform: scale(1.05);
    }
}





.jws_slider_video_slider .slider-item , .jws_slider .slider-item {
	padding:0;
}
.jws_account .dropdown-menu li.nav-profile {
	display:block !important;
}
.jws-pmpro-level-element .layout1 .active .pmpro-level-inner {
	    padding: 48px 30px;
}
.profile-header .header-bottom .nav li.nav-billing {
display:none;
}
.comments-area .comment_top .comment-list li .comment-body .comment-avatar img {
	    object-fit: cover;
			height:80px;
}

.comment-form-rating .select2 {
	display:none !important;
}

.jws_search.icon_left .search-results-wrapper {
	min-width:300px;
}

.post-inner.hover-video .post-media img {
	border-radius:5px;
}

.elementor-widget .jws-menu-list .elementor-icon-list-items {
	margin-top:23px;
}

.elementor-widget .jws-menu-list .columns-2 {
	margin-left:-10px;
	margin-right:-10px;
}

.vjs-modal-dialog.vjs-text-track-settings {
	height:100% !important;
}

.vjs-modal-dialog.vjs-text-track-settings .select2-container {
	margin-right:10px;
}
.vjs-track-setting > select , .vjs-text-track-settings fieldset span > select {
	    max-width: 150px;
}

select {
	 background-image:url("data:image/svg+xml;charset=utf8, %3Csvg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%23fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='feather feather-chevron-down'%3E%3Cpolyline points='6 9 12 15 18 9'%3E%3C/polyline%3E%3C/svg%3E");
   
}

@media(max-width:767px) {
	.vjs-track-setting > select, .vjs-text-track-settings fieldset span > select {
		max-width: 110px;
    min-height: 30px;
	}
}

.jws_slider_video_item {
	overflow:hidden;
}


.search-btn,
.jws-search-btn {
    font-size: 0 !important;
}


.archive-nav .post-select-filter {display:none;}
.archive-nav .post-select-filter {display:none;}
#share-videos p:nth-child(3) { display: none; }
.nav-playlist , .nav-video {display:none !important;}

div.col-lg-8 p,
div.col-lg-8 p strong,
div.col-lg-8 span,
div.col-lg-8 li {
    color: #ffffff !important;
}
.video_title,
