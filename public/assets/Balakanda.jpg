    <div style="text-align:center;color:#fff;padding:10px;background:#222;">📍 Detected Country: <strong>IN</strong> | IP: <strong>106.51.28.238</strong></div>    <script>
    document.addEventListener("DOMContentLoaded", function () {
      const container = document.querySelector(".tv-shows-advanced-content.row.layout1");
      if (!container) return;

      const items = container.querySelectorAll(".jws-post-item");

      let item1 = null, item2 = null;

      items.forEach(item => {
        const title = item.innerText.trim();
        if (title.includes("Sanskrit Vocabulary Builder – 2")) item1 = item;
        if (title.includes("Sanskrit Vocabulary Builder – 1")) item2 = item;
      });

      if (item1 && item2) {
        const next = item2.nextSibling;
        container.insertBefore(item2, item1);
        container.insertBefore(item1, next);
      }
    });
    </script>
    <script>
document.addEventListener("DOMContentLoaded", function () {
  const waitForIcons = setInterval(() => {
    const shareContainer = document.querySelector(".post-share-inner");
    const existingIcons = shareContainer?.querySelectorAll("a");
    if (shareContainer && existingIcons.length > 0) {
      clearInterval(waitForIcons);
      // Prevent duplicate icons
