        <script>
    document.addEventListener("DOMContentLoaded", function () {
        const genreTitles = {
            "world-of-chants": "World of Chants",
            "language-learning": "Language Learning",
            "stories-subhashitas": "Stories & Subhashitas",
            "evergreen-epics-puranas": "Evergreen Epics & Puranas",
            "vedanta-vedanta": "Vedanta",
            "games-activities": "Games & Activities",
            "bhakti-bhava-lahari": "Bhakti Bhava Lahari",
            "grammar-simplified": "Grammar Simplified",
            "literature": "Literature",
            "roots-of-dharma": "Roots of Dharma",
            "iks": "Indian Knowledge Systems (IKS)",
            "kids": "Kids"
        };

        function insertHeading() {
            const path = window.location.pathname;
            const matchedSlug = Object.keys(genreTitles).find(slug => path.includes(`/genre/${slug}/`));

            if (matchedSlug && !document.querySelector('.custom-genre-heading')) {
                const headingText = genreTitles[matchedSlug];
                const container = document.querySelector(".site-main .container .row");

                if (container) {
                    const wrapper = document.createElement("div");
                    wrapper.className = "custom-genre-heading";
                    wrapper.style.width = "100%";
                    wrapper.style.margin = "0 0 10px 0";
                    wrapper.style.padding = "0";

                    const heading = document.createElement("h1");
                    heading.textContent = headingText;
                    heading.style.textAlign = "left";
                    heading.style.color = "white";
                    heading.style.fontSize = "36px";
                    heading.style.margin = "0";

                    wrapper.appendChild(heading);
                    container.parentElement.insertBefore(wrapper, container);
                    console.log(`✅ Inserted title: ${headingText}`);
                }
            }
        }

        insertHeading();

        // MutationObserver to re-inject title after AJAX loads
        const observer = new MutationObserver(() => {
            insertHeading();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
    </script>
