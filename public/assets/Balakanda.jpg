        <script>
    document.addEventListener("DOMContentLoaded", function () {
        const listenButton = document.querySelector('.btn-main.button-default.jws-play');
        const dropdownItems = document.querySelectorAll('.dropdown-menu .dropdown-item');
        const dropdownToggle = document.querySelector('.dropdown-toggle.selected');
        const episodeSlider = document.querySelector('.episodes-content');

        if (!listenButton || dropdownItems.length === 0 || !episodeSlider) return;

        function updateURLFromFirstActiveItem() {
            const firstActive = document.querySelector('.owl-item.active .post-inner .episodes-info h6 a');
            if (firstActive && firstActive.href) {
                listenButton.setAttribute('href', firstActive.href);
                console.log("Updated URL to:", firstActive.href);
            }
        }

        // Use MutationObserver to watch for episode content change
        const observer = new MutationObserver((mutationsList, observer) => {
            for (const mutation of mutationsList) {
                if (mutation.type === 'childList' || mutation.type === 'attributes') {
                    updateURLFromFirstActiveItem();
                    break;
                }
            }
        });

        observer.observe(episodeSlider, {
            childList: true,
            subtree: true,
            attributes: true,
        });

        // Handle dropdown selection
        dropdownItems.forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                const newValue = this.textContent.trim();
                if (dropdownToggle) dropdownToggle.textContent = newValue;

                // Carousel will update – our observer will detect and act
            });
        });

        // Initial update on page load
        updateURLFromFirstActiveItem();
    });
    </script>
        <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Rename 'Favorite Movies' to 'Your Favorites'
        const favHeading = document.querySelector('.favorites-page h5.title-post-type');
        if (favHeading && favHeading.textContent.trim() === 'Favorite Movies') {
            favHeading.textContent = 'Your Favorites';
