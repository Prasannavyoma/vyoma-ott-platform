    <script>
    jQuery(document).ready(function($) {
        $('.netflix-slider-container').each(function() {
            const slider = $(this).find('.netflix-slider');
            $(this).append('<button class="netflix-slider-nav netflix-slider-prev">❮</button><button class="netflix-slider-nav netflix-slider-next">❯</button>');
            
            $(this).on('click', '.netflix-slider-prev', function() {
                slider.animate({scrollLeft: slider.scrollLeft() - 300}, 300);
            });
            
            $(this).on('click', '.netflix-slider-next', function() {
                slider.animate({scrollLeft: slider.scrollLeft() + 300}, 300);
            });
        });
    });
    </script>
        <style>
        .jws-post-item .post-media,
        .jws-movie-advance .movie-item .thumb,
        .jws-video-advance .video-item .thumb {
            position: relative !important;
            width: 100% !important;
            padding-top: 56.25% !important; /* 16:9 aspect ratio */
            overflow: hidden !important;
            background-size: contain !important;
            background-repeat: no-repeat !important;
            background-position: center center !important;
            background-color: #000; /* fallback bg */
        }

        .jws-top-videos-tabs-element .layout1 .top-videos-inner a img.size-size-458x9999 {
            max-width: unset;
        }
    </style>

    <script>
        function applyBackgroundImageFix() {
            const selectors = [
                '.jws-post-item .post-media',
                '.jws-movie-advance .movie-item .thumb',
                '.jws-video-advance .video-item .thumb'
            ];

            selectors.forEach(selector => {
                document.querySelectorAll(selector).forEach(wrapper => {
                    const img = wrapper.querySelector('img');
                    if (!img || wrapper.dataset.bgDone === "1") return;

                    let url = img.src;
                    const srcset = img.getAttribute('srcset');
                    if (srcset) {
                        const candidates = srcset.split(',');
                        const last = candidates[candidates.length - 1].trim().split(' ')[0];
                        if (last) url = last;
                    }

                    const isCustom = wrapper.matches('.post-media') && wrapper.classList.contains('post-media__custom');
                    if (!isCustom) {
                        url = url.replace(/-\d+x\d+(?=\.[a-z]{3,4}(\?|$))/i, '');
                    }

                    wrapper.style.backgroundImage = `url('${url}')`;
                    img.style.display = 'none';
                    wrapper.dataset.bgDone = "1";
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            applyBackgroundImageFix();

            const observer = new MutationObserver((mutations) => {
                let needsUpdate = false;
                mutations.forEach(m => {
                    if ([...m.addedNodes].some(n => n.nodeType === 1)) {
                        needsUpdate = true;
                    }
                });
                if (needsUpdate) {
                    setTimeout(applyBackgroundImageFix, 200); // slight delay to allow images to load
                }
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        });
    </script>
      <script type="text/javascript">
  jQuery(function($){
    function tweakProfileLink(){
      var $menu = $('.jws_account .dropdown-menu ul.nav');
      if (!$menu.length) return;
      
      // find the item whose link text starts with “Setting”
      var $settingItem = $menu.find('li').filter(function(){
        return $(this).find('a').text().trim().indexOf('Setting') === 0;
      }).first();
      // find Favorites the same way
      var $favoritesItem = $menu.find('li').filter(function(){
        return $(this).find('a').text().trim().indexOf('Favorites') === 0;
      }).first();

      if (!$settingItem.length || !$favoritesItem.length) return;
      if ($settingItem.hasClass('jws-tweaked')) return;

      // rename + add icon (FontAwesome here—swap if needed)
      $settingItem.find('a').html('<i class="fa fa-user-circle"></i> My Profile');
      // move above Favorites
      $settingItem.insertBefore($favoritesItem);
      $settingItem.addClass('jws-tweaked');
      console.log('✅ Renamed “Setting” → “My Profile” and moved it above “Favorites”');
    }

    // run on page load (if menu is already in DOM)
    tweakProfileLink();

    // run after the dropdown opens
    $(document).on('click', '.jws_account .dr-button', function(){
      setTimeout(tweakProfileLink, 50);
    });
  });
  </script>
      <script>
    jQuery(document).ready(function($) {
        var $carousel = $('.top-videos-content');

        if ($carousel.hasClass('owl-loaded')) {
            $carousel.trigger('destroy.owl.carousel');
        }

        $carousel.owlCarousel({
            loop: true,
            margin: 20, // Give some space between items
            nav: true,
            responsive: {
                0: {
                    items: 1.2 // Slightly more than 1, enables visible hint of next
                },
                480: {
                    items: 1.5
                },
                768: {
                    items: 2
                },
                1024: {
                    items: 2.5
                },
                1280: {
                    items: 3
                }
            }
        });
    });
    </script>
      <style>
    /* 1) Force every .post-media to 16∶9 */
    .owl-item .post-media,
    .jws-pisodes_advanced-item .post-media {
      position: relative !important;
      width:  100%      !important;
      height: 0         !important;
      padding-top: 56.25% !important; /* 9 ÷ 16 = 56.25% */
      overflow: hidden !important;
    }

    /* 2) Absolutely cover that box with the IMG */
    .owl-item .post-media img,
    .jws-pisodes_advanced-item .post-media img {
      position: absolute       !important;
      top:      0              !important;
      left:     0              !important;
      width:    100%           !important;
      height:   100%           !important;
      object-fit:       cover          !important;
      object-position: center center !important;
    }
  </style>
  <script>
  document.addEventListener('DOMContentLoaded', function(){
    // 3) Swap each 388x470 thumbnail for the original full-size image
    document.querySelectorAll('.post-media img').forEach(function(img){
      var wrapper = img.closest('.post-media');
      var isCustom = wrapper && wrapper.classList.contains('post-media__custom');

      if (!isCustom) {
        // Remove "-WIDTHxHEIGHT" before file extension
        var fullSrc = img.src.replace(/-\d+x\d+(?=\.\w+$)/, '');
        if (fullSrc !== img.src) {
          img.src = fullSrc;
        }
      }
    });
  });
  </script>
    <script>
    (function () {
      function updateButton(attempts = 0) {
        const upgradeBtn = document.querySelector(".update-nember .btn-main.button-default");
        if (upgradeBtn) {
          // Set clean text and remove any existing icon or content
          upgradeBtn.innerHTML = 'Change Your Plan';
        } else if (attempts < 10) {
          setTimeout(() => updateButton(attempts + 1), 300);
        }
      }
      updateButton();
    })();
  </script>
      <script>
    (function() {
        var gameProducts = [
            '/Products/memory_game/',
            '/Products/ganesha_pooja/',
            '/Products/word_search/',
            '/Products/design_your_house/',
            '/Products/cooking/',
            '/Products/sravana_koshalm_1/',
            '/Products/sravana_koshalm_2/',
            '/Products/nalpaaka_kreeda/',
            '/Products/sarvanamani/',
            '/Products/vowels/',
            '/Products/tavarga_consonant_class/',
            '/Products/kavarga_consonant_class/',
            '/Products/conjunct_consonants_activity_1/',
            '/Products/consonant_series_activity_1/',
            '/Products/comprehension_skill_activity_1/',
            '/Products/comprehension_skill_activity_2/',
            '/Products/comprehension_skill_activity_3/',
            '/Products/feminine_words/',
            '/Products/masculine_words/',
            '/Products/neuter_words/',
            '/Products/pronouns/',
            '/Products/listening_skill_activity_1/',
            '/Products/listening_skill_activity_2/',
            '/Products/design_our_house/',
            '/Products/climb_the_summit/',
            '/Products/treasure_map/',
            '/Products/snake_and_ladder/'
        ];
        
        var currentURL = window.location.pathname;
        
        for (var i = 0; i < gameProducts.length; i++) {
            if (currentURL === gameProducts[i]) {
                var dropdown = document.querySelector('.select-seasion');
                if (dropdown) {
                    dropdown.style.display = 'none';
                }
                break;
            }
        }
    })();
    </script>
        <script>
    (function() {
        var hideDropdownPages = [
            '/Products/samhati-karyasadhika-video/',
            '/Products/mookapanchashati_aryashatakam_video/',
            '/Products/amarakosha-manushyavarga/' // your podcast page
        ];
        
        var currentURL = window.location.pathname;

        for (var i = 0; i < hideDropdownPages.length; i++) {
            if (currentURL === hideDropdownPages[i]) {
                var dropdown = document.querySelector('.select-seasion');
                if (dropdown) {
                    dropdown.style.display = 'none';
                }
                break;
            }
        }
    })();
    </script>
        <script>
    (function() {
        // Check if URL contains /Products/ (single product page)
        if (window.location.pathname.indexOf('/Products/') === -1) return;
        
        // Check if "GAMES" category text exists on page
        var gamesText = document.querySelector('.jws-category a[href*="/product_category/Games/"]');
        
        if (gamesText) {
            // Hide ONLY the season dropdown
            var dropdown = document.querySelector('.select-seasion');
            if (dropdown) {
                dropdown.style.display = 'none';
            }
        }
    })();
    </script>
    
