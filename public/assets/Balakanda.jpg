<script id="contextmenu-guard">
(function () {
  // 1) One handler that blocks the menu at the capture phase
  function stop(e){ 
    e.preventDefault(); 
    e.stopPropagation(); 
    return false; 
  }

  // 2) Attach to window, documentElement and document (capture phase)
  ['contextmenu'].forEach(function(evt){
    window.addEventListener(evt, stop, {capture:true});
    document.addEventListener(evt, stop, {capture:true});
    (document.documentElement||document).addEventListener(evt, stop, {capture:true});
  });

  // 3) Re-arm periodically in case another script removes listeners
  //    (keeps it working on dynamically loaded pages)
  setInterval(function(){
    window.addEventListener('contextmenu', stop, {capture:true});
    document.addEventListener('contextmenu', stop, {capture:true});
    (document.documentElement||document).addEventListener('contextmenu', stop, {capture:true});
  }, 1500);

  // 4) Also block image dragging (common save path)
  document.addEventListener('dragstart', function(e){
    if (e.target && (e.target.tagName === 'IMG' || e.target.closest('img,picture,figure'))) {
      e.preventDefault();
    }
  }, {capture:true});

  // Optional: tiny visual cue you can see in DevTools console
  try { console.log('Right-click guard active'); } catch(e){}
})();
</script>
