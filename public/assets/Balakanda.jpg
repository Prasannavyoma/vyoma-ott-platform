<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TDG6SGP8 "
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->  <script>
  (function () {
    // 1) Disable right-click everywhere (except elements you whitelist with .allow-context)
    const blockContext = (e) => {
      if (e.target.closest('.allow-context')) return; // opt-out class if you ever need it
      e.preventDefault();
    };
    document.addEventListener('contextmenu', blockContext, { capture: true });

    // 2) "Harden" media elements to hide download UI
    function hardenMedia(node) {
      if (!node || !node.tagName) return;
      const tag = node.tagName.toUpperCase();

      // Never show context menu on media
      node.setAttribute('oncontextmenu', 'return false');

      if (tag === 'VIDEO' || tag === 'AUDIO') {
        // Add controlsList flags
        const list = (node.getAttribute('controlsList') || '')
          .split(/\s+/).filter(Boolean);
        if (!list.includes('nodownload')) list.push('nodownload');
        if (tag === 'VIDEO' && !list.includes('noremoteplayback')) list.push('noremoteplayback');
        node.setAttribute('controlsList', list.join(' '));

        // Block Picture-in-Picture where supported
        node.setAttribute('disablepictureinpicture', '');
        node.addEventListener('enterpictureinpicture', (e)=>e.preventDefault(), {capture:true});
      }

      // Optional: also block context menu on common assets
      if (tag === 'IMG' || tag === 'CANVAS' || tag === 'IFRAME' || tag === 'EMBED' || tag === 'OBJECT') {
        node.setAttribute('oncontextmenu', 'return false');
      }
    }

    function applyAll(ctx) {
      (ctx || document).querySelectorAll('video,audio,img,canvas,iframe,embed,object')
        .forEach(hardenMedia);
    }

    applyAll(document);
    // Re-apply when content is added dynamically (carousels, ajax, etc.)
    new MutationObserver(muts => muts.forEach(m =>
      m.addedNodes && m.addedNodes.forEach(n => {
        if (n.nodeType === 1) { hardenMedia(n); applyAll(n); }
      })
    )).observe(document.documentElement, { childList: true, subtree: true });
  })();
  </script>
      
