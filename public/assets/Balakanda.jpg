//quiz app

/* QSM: reset base look of each answer row */
.qsm-answers li,
.mlw_qmn_question li,
.mlw_qmn_question label {
  background: transparent !important;
  color: inherit;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,.12);
  padding: 10px 14px;
  transition: background-color .15s ease, color .15s ease, border-color .15s ease;
}

/* Highlight when the choice is selected (modern browsers) */
.qsm-answers li:has(input:checked),
.mlw_qmn_question li:has(input:checked),
.mlw_qmn_question .qmn_mc_answer:has(input:checked),
.mlw_qmn_question .qmn_checkbox:has(input:checked) {
  background: #2b2b2b !important;   /* dark gray */
  color: #ffffff !important;
  border-color: #2b2b2b !important;
}

/* Fallback for layouts where label sits next to input */
.mlw_qmn_question input[type="radio"]:checked + label,
.mlw_qmn_question input[type="checkbox"]:checked + label,
.qsm-answers input[type="radio"]:checked + label,
.qsm-answers input[type="checkbox"]:checked + label {
  background: #2b2b2b !important;
  color: #ffffff !important;
  border-color: #2b2b2b !important;
}

/* Keep controls readable on dark */
.mlw_qmn_question input[type="radio"],
.mlw_qmn_question input[type="checkbox"] {
  accent-color: #ffffff;
}


